# UoS Seat Monitor - environment variables
# Copy this file to .env and fill in your values.

# --- ntfy push notifications (required) ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=<long-random-private-topic>

# --- Gmail backup (optional) ---
GMAIL_ENABLED=false
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
ALERT_RECIPIENT=
